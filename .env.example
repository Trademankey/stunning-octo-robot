# ─────────────────────────────────────────────────────
# Crypto Trading Bot — Environment Variables
# Copy to .env and fill in your secrets
# ─────────────────────────────────────────────────────

# ── Exchange ──────────────────────────────────────────
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
EXCHANGE_SANDBOX=true
EXCHANGE_RATE_LIMIT=1200

# ── Trading Mode ─────────────────────────────────────
TRADING_MODE=paper
MARKET_TYPE=futures
HEDGE_MODE=true

# ── Pairs ────────────────────────────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,TON/USDT

# ── Database ─────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading_bot
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_strong_password_123

# ── Redis ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Telegram ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_ENABLED=true

# ── On-chain Data ────────────────────────────────────
DUNE_API_KEY=your_dune_api_key
GLASSNODE_API_KEY=your_glassnode_api_key

# ── Sentiment ────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ── Risk Management ─────────────────────────────────
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_DRAWDOWN=0.05
MAX_CORRELATED_PAIRS=3
KELLY_FRACTION=0.25

# ── Model Training ───────────────────────────────────
RETRAIN_INTERVAL_HOURS=8
OPTUNA_TRIALS=500
WALK_FORWARD_SPLITS=5
MONTE_CARLO_SIMULATIONS=1000

# ── Monitoring ───────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
HEALTH_CHECK_INTERVAL=30
LOG_LEVEL=INFO
LOG_DIR=./logs
